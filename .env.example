# ── Lokale Entwicklung: Kopie als .env.local (wird von Next.js geladen, nicht committen) ──

# NextAuth (Admin) – in Vercel als Environment Variables
# WICHTIG: Lokal immer http://localhost:PORT (nicht die Produktions-URL), sonst stimmen
# Session-Cookie-Name (Middleware) und API nicht überein → Login-Loop ohne Fehlermeldung.
# Optional: NEXTAUTH_IGNORE_LOCAL_URL=1 wenn du die URL absichtlich nicht anpassen willst.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Optional: Auth.js v5-Alias
# AUTH_SECRET=

# MongoDB Atlas – Connection String (mongoose + native driver nutzen MONGODB_URI)
# Beispiel-Form:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/DATABASE?retryWrites=true&w=majority&appName=AppName
# Sonderzeichen im Passwort URL-encodieren oder in Atlas ein einfacheres Passwort wählen.
MONGODB_URI=

# Falls du aus Versehen MongoDB_URI (falsche Groß/Klein) gesetzt hast, wird es beim Start
# auf MONGODB_URI gemappt (siehe instrumentation.ts).

# Optional: Admin-User in MongoDB anlegen/aktualisieren (Passwort nicht ins Repo committen)
# npx tsx scripts/create-admin-user-info.ts
# ADMIN_SEED_EMAIL=info@it-techvision.de
# ADMIN_SEED_PASSWORD=

# Kurzzeitig auf 1 setzen: Vercel-Logs zeigen userFound/passwordOk (ohne Passwort)
# AUTH_LOGIN_DEBUG=1

# OpenAI (Admin: FAQ-Massenimport mit KI) – nur serverseitig, nie ins Client-Bundle
# Bevorzugte Variablennamen:
# Open_ai_key=sk-...
# openai_model=gpt-4o-mini
# Legacy (wird weiterhin akzeptiert): OPENAI_API_KEY, OPENAI_FAQ_MODEL

# MinIO (S3-kompatibel) – Admin-Uploads für Blog, Case Studies, Testimonials, Seiteninhalte
# Ohne diese Variablen: Uploads nach public/uploads/<kontext>/ (lokal)
#
# Vercel/Production: MINIO_ENDPOINT darf NICHT localhost sein – nur eine Adresse, die vom
# Serverless-Standort aus erreichbar ist (öffentlicher Host, Tunnel oder Reverse-Proxy).
# MINIO_ENDPOINT darf auch vollständige URL sein, z. B. https://minio.example.com
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# Bucket: MINIO_BUCKET_NAME oder Alias MINIO_BUCKET (beide werden unterstützt)
# MINIO_BUCKET_NAME=techvision-uploads
# MINIO_BUCKET=mein-bucket
# Bei manchen Providern nötig: MINIO_PATH_STYLE=true
# Fehlerdetails in /api/upload-JSON (nur Debug): MINIO_UPLOAD_DEBUG=1
# Öffentliche Basis-URL für next/image & Browser (ohne trailing slash), z. B. https://cdn.example.com
# MINIO_PUBLIC_URL=http://localhost:9000

# ── Kontaktseite (/contact) ──
# Öffentliche Telefonanzeige (optional), z. B. +49 203 12345678
# NEXT_PUBLIC_CONTACT_PHONE=
# Optional: POST /api/contact leitet JSON an Webhook (z. B. n8n) weiter
# CONTACT_WEBHOOK_URL=
