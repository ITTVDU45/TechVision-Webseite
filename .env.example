# Next.js Admin (NextAuth) – für Production z. B. in Vercel → Environment Variables eintragen
# Kanonische URL der Site (mit https, ggf. www – exakt wie im Browser)
NEXTAUTH_URL=https://www.it-techvision.de

# Mindestens 32 Zeichen, z. B. openssl rand -base64 32
NEXTAUTH_SECRET=

# Optional: Auth.js v5-kompatibler Alias für dasselbe Secret
# AUTH_SECRET=
